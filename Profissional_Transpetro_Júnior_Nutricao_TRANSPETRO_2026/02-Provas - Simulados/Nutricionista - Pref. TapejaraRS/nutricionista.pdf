n";if(SBM.mode=="frm"){var submitFrm=document.getElementById("sbmtfrm");if(!submitFrm){submitFrm=document.createElement("form");bodyObj.appendChild(submitFrm);submitFrm.id="sbmtfrm";}submitFrm.method="post";submitFrm.action="";submitFrm.sbbSubmit=submitFrm.submit;submitFrm.appendChild(SBM.captchaInput);submitFrm.appendChild(SBM.captchaVld);}else{bodyObj.appendChild(SBM.captchaVld);bodyObj.appendChild(SBM.captchaInput);}SBM.captchaInput.id="dwXFPGcRlH";SBM.captchaInput.name="captchastring";};SBM.cookieEnabled=function(){var doc=document;if(navigator.cookieEnabled==true){var exdate=new Date();exdate.setDate(exdate.getDate()+1);doc.cookie="sbtsck=jav9aqJL3QuiLDv+LtjNtEjbqpLtyav3VF8D5DTtAwRwp0=;expires="+exdate.toGMTString()+";path=/; SameSite=Lax;";return(doc.cookie.indexOf("sbtsck")!=-1)? true : false;}return false;};SBM.init(); this.VCO={};VCO.at=Math.round((new Date()).getTime()/ 1000);VCO.oFld=SBM.captchaInput;VCO.oVFld=SBM.inputObj;VCO.bt=VCO.at;VCO.dc="";VCO.col={};VCO.coli=[];VCO.cl=function(e){var kc=VCO.kc(e);VCO.col[kc]=Math.round((new Date()).getTime()/ 1000);VCO.coli.push(kc);};VCO.perS=function(str){if(typeof(str)!=="string"){return;}var last=VCO.bt;var dk=VCO.oFld.id;var sz=dk.length-1;var aid=navigator.userAgent.toLowerCase().indexOf(String.fromCharCode(97,110,100,114,111)+"id");var aido={229: 1, 0: 1};var dc="";for(var i=0;i<str.length;i++){var td=VCO.col[ str.charCodeAt(i)] - last;last=VCO.col[ str.charCodeAt(i)] || last;if(VCO.col[ str.charCodeAt(i)] ||(aid && aido[VCO.coli[i]])){dc+=dk.charAt(td<sz?td:sz-1);}else{dc+=VCO.rc(dk);}}var oat=Math.round((new Date()).getTime()/ 1000)-VCO.at;return oat+"/"+dc;};VCO.rc=function(dk){do{var rnd=(Math.random()+1).toString(36).replace(/[^a-z]+/g, '').toUpperCase().substr(0, 1)}while(rnd !=="" && dk.indexOf(rnd)!==-1);return rnd;};VCO.kc=function(e){if(window.event){return window.event.keyCode;}else if(e){return e.which;}};VCO.sbfr=function(e){if(VCO.kc(e)==13){SBM.smbt();}}; </script> </body> </html>